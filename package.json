{
  "name": "@local/dsh-weread-shelf",
  "version": "0.9.5",
  "private": true,
  "description": "书屿 · 微信读书书架：书架、独立窗口阅读、AI 陪读台、写入 Obsidian（DSH 左侧栏面板）",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "weread",
    "wechat-reading",
    "obsidian",
    "bookshelf",
    "reading",
    "ai"
  ],
  "license": "MIT",
  "author": "书屿 contributors",
  "type": "module",
  "homepage": "https://github.com/SaltedFish-ZZJ/dsh-weread-shelf#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SaltedFish-ZZJ/dsh-weread-shelf.git"
  },
  "bugs": {
    "url": "https://github.com/SaltedFish-ZZJ/dsh-weread-shelf/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node --check index.js && node --check weread.js && node --check client.js",
    "test": "node tests/smoke.mjs && node tests/host.mjs",
    "test:live": "node tests/host.mjs --live",
    "shots": "node tests/shots.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "weread.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/*.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}